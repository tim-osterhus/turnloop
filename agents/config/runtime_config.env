# Turnloop loop-runtime supervision config (live-reload on worker restart)
#
# The long-lived loop scripts read these values via the shared runtime helper.
# If this file is missing or malformed, the loops fall back to safe defaults.

# How long a supervisor waits before retrying a loop after an unexpected crash.
RUNTIME_RETRY_DELAY_SECS=3600

# Sleep chunk size for idle waits and retry backoff. Smaller values make script
# edits and config changes take effect sooner without manual pane restarts.
RUNTIME_SLEEP_SLICE_SECS=15

# When true, loop workers restart themselves after watched script/config drift.
RUNTIME_REEXEC_ON_DRIFT=true

# When true, loops keep a JSON runtime-state heartbeat under agents/.tmp/runtime.
RUNTIME_HEARTBEAT_ENABLED=true

# Exit code reserved for "restart me immediately because watched files changed".
RUNTIME_REEXEC_EXIT_CODE=75

# When true, Codex stage failures trigger a provider-connectivity probe before
# the loop treats them as real blockers. If the probe fails, the stage waits for
# connectivity recovery and then retries the same entrypoint.
RUNTIME_CONNECTIVITY_RETRY_ENABLED=true

# Provider reachability probe. Leave COMMAND empty to use the default HTTPS
# check against api.openai.com. Set COMMAND only if you need a custom probe.
RUNTIME_CONNECTIVITY_CHECK_URL=https://api.openai.com/
RUNTIME_CONNECTIVITY_CHECK_COMMAND=

# Probe timeouts for the provider reachability check.
RUNTIME_CONNECTIVITY_CHECK_CONNECT_TIMEOUT_SECS=5
RUNTIME_CONNECTIVITY_CHECK_MAX_TIME_SECS=10

# Backoff schedule after failed connectivity probes: first wait, second wait,
# then the steady-state wait that repeats until connectivity returns.
RUNTIME_CONNECTIVITY_BACKOFF_INITIAL_SECS=60
RUNTIME_CONNECTIVITY_BACKOFF_SECOND_SECS=300
RUNTIME_CONNECTIVITY_BACKOFF_STEADY_SECS=900

# When true, Codex entrypoints that fail before real startup with only bare
# `Error: No such file or directory (os error 2)` log lines are treated as
# transient Codex infra faults and retried.
RUNTIME_CODEX_INFRA_RETRY_ENABLED=true
RUNTIME_CODEX_INFRA_RETRY_MAX_ATTEMPTS=3
RUNTIME_CODEX_INFRA_BACKOFF_INITIAL_SECS=5
RUNTIME_CODEX_INFRA_BACKOFF_SECOND_SECS=20
RUNTIME_CODEX_INFRA_BACKOFF_STEADY_SECS=60
