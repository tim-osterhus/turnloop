# Seed loop live config
#
# The seed loop reloads this file before each tick and during the between-tick
# wait. seed_prompt.sh also reloads it on every run, so prompt and usage
# behavior can change without restarting the loop.

# Numbered prompt directory contract:
# - files must begin with an integer, e.g. `1-corebound.md`, `2-new-game.md`
# - the loop advances to the next integer if it exists
# - if the next integer is missing, the rotation wraps back to prompt `1`
SEED_PROMPTS_DIR=agents/prompts/seed

# Normal target time between successful seed emissions. The scheduler recomputes
# this from persisted seed state across restarts instead of anchoring on check
# attempts.
SEED_INTERVAL_SECS=21600

# Minimum time that must pass before a new seed can actually be emitted.
# This is the real cadence guard for prompt injection.
SEED_MIN_INTERVAL_SECS=21600

# Usage check source:
# - codex
# - file
# - cmd
# - auto
# - none
SEED_USAGE_SOURCE=codex

# Skip seeding when remaining weekly usage drops below this integer percent.
SEED_USAGE_MIN_REMAINING_PCT=45

# What to do when the usage check produces no usable value:
# - skip
# - continue
SEED_USAGE_FAILURE_BEHAVIOR=skip

# Retry timings used when a due-time check does not emit a seed.
SEED_USAGE_UNKNOWN_RETRY_SECS=300
SEED_USAGE_LOW_RETRY_SECS=3600
SEED_ERROR_RETRY_SECS=300

# Optional file/cmd usage sources.
SEED_USAGE_FILE=agents/.tmp/usage_remaining_pct.txt
SEED_USAGE_CMD=

# Timeout for the codex app-server usage probe.
SEED_USAGE_PROBE_TIMEOUT_SECS=15
