# Turnloop loop-behavior config
#
# Both long-lived loops reload these values while running, so entrypoint routing,
# delay tuning, and retry behavior can change without a manual loop restart.
# Missing or invalid values fall back to safe defaults in the loop scripts.

# Orchestrate entrypoints.
ORCH_ENTRY_START=agents/entrypoints/_start.md
ORCH_ENTRY_CHECK=agents/entrypoints/_check.md
ORCH_ENTRY_TROUBLE=agents/entrypoints/_troubleshoot.md
ORCH_ENTRY_UPDATE=agents/entrypoints/_update.md

# Orchestrate delays.
ORCH_IDLE_POLL_SECS=120
ORCH_PROMOTE_DELAY_SECS=180
ORCH_PENDING_TRANSFER_DELAY_SECS=60
ORCH_BACKLOG_PROMOTE_DELAY_SECS=180

# Orchestrate retry and blocked-state behavior.
ORCH_QUICKFIX_MAX_ATTEMPTS=2
ORCH_UPDATE_MAX_ATTEMPTS=2
ORCH_TROUBLESHOOT_MAX_ATTEMPTS=2
ORCH_TROUBLESHOOT_ON_BLOCKED=true
ORCH_TROUBLESHOOT_ON_UNEXPECTED_STATUS=true

# Research entrypoints.
RESEARCH_ENTRY_RESEARCH=agents/entrypoints/_research.md
RESEARCH_ENTRY_MANAGE=agents/entrypoints/_manage.md
RESEARCH_ENTRY_MECHANIC=agents/entrypoints/_mechanic.md

# Research delays.
RESEARCH_POLL_SECS=120
RESEARCH_PROMOTE_DELAY_SECS=180
RESEARCH_RESEARCH_DELAY_SECS=180
RESEARCH_MANAGE_DELAY_SECS=180

# Research retry and repair behavior.
RESEARCH_MECHANIC_MAX_ATTEMPTS=2
RESEARCH_MECHANIC_ON_BLOCKED=true
RESEARCH_MECHANIC_ON_UNEXPECTED_STATUS=true
